POSTGRES_URL=postgresql+asyncpg://vg_user:vg_pass@localhost:5432/vg_hub
POSTGRES_USER=vg_user
POSTGRES_PASSWORD=vg_pass
POSTGRES_DB=vg_hub

# Fernet key for EncryptedJSON columns (suppliers.auth_config, customers.ops_auth_config).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# Shared secret for n8n → FastAPI ingest endpoints (POST /api/ingest/{sid}/...).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_SHARED_SECRET=

# SanMar SFTP Connection
SANMAR_SFTP_HOST=ftp.sanmar.com
SANMAR_SFTP_PORT=2200
SANMAR_SFTP_USER=
SANMAR_SFTP_PASS=

# CORS — comma-separated list of allowed origins for the FastAPI backend
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# n8n → FastAPI base URL (used by all n8n workflows via $env.API_BASE_URL)
# When n8n runs in Docker calling the host machine: http://host.docker.internal:8000
# When n8n runs natively (not in Docker):            http://localhost:8000
# Production:                                        https://your-api-domain.com
API_BASE_URL=

# PromoStandards
PS_DIRECTORY_URL=https://services.promostandards.org/WebServiceRepository/WebServiceRepository.svc/json

# n8n Workflows
MASTER_OPTIONS_SYNC_WORKFLOW_ID=ops-master-options-pull-001
NEXT_PUBLIC_PUSH_WORKFLOW_ID=vg-ops-push-001
NEXT_PUBLIC_N8N_URL=http://localhost:5678

# ── Production only ────────────────────────────────────────────────────────────

# Environment tag — set to "production" in prod to enforce Fernet key validation
# ENVIRONMENT=production

# CORS — comma-separated list of allowed origins (production frontend URL)
# ALLOWED_ORIGINS=https://app.staging.example.com

# n8n base URL for backend → n8n trigger calls
# N8N_BASE_URL=https://n8n.staging.example.com

# AWS Secrets Manager (production) — ARNs injected by CloudFormation App Runner config
# SECRET_KEY pulled from: api-hub/<env>/SECRET_KEY
# INGEST_SHARED_SECRET pulled from: api-hub/<env>/INGEST_SHARED_SECRET
# POSTGRES_URL pulled from: api-hub/<env>/POSTGRES_URL

# ── Monitoring (optional) ──────────────────────────────────────────────────────

# Link shown on /monitoring page — leave blank to hide
NEXT_PUBLIC_GRAFANA_URL=
NEXT_PUBLIC_DATADOG_URL=

