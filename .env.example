# ─── REQUIRED IN PRODUCTION ─────────────────────────────────────────────────
# These variables MUST be set when ENVIRONMENT=production. The backend refuses
# to boot if any of them are unset. In ECS Fargate they come from
# Secrets Manager via the task definition.

# Connection string for asyncpg
POSTGRES_URL=postgresql+asyncpg://vg_user:vg_pass@localhost:5432/vg_hub

# Fernet key for EncryptedJSON columns (suppliers.auth_config, customers.ops_auth_config).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# Separate secret for JWT signing. Falls back to SECRET_KEY in development with
# a startup warning; required (no fallback) when ENVIRONMENT=production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# Shared secret for trusted service → FastAPI ingest endpoints
# (POST /api/ingest/{sid}/...). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_SHARED_SECRET=

# CORS — comma-separated list of allowed origins for the FastAPI backend.
# In production this list is the only way to allow a browser origin.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Sentry error tracking (optional — leave blank to disable)
# Get DSN from sentry.io → Project → Settings → Client Keys
SENTRY_DSN=
# Fraction of requests traced (0.0–1.0). Default 0.2 (20%). Lower in high-traffic prod.
SENTRY_TRACES_SAMPLE_RATE=0.2

# OPS push concurrency — max parallel push tasks per batch call.
# Default 4. Raise carefully: each task opens a DB connection + OPS OAuth token.
OPS_PUSH_CONCURRENCY=4

# ─── DEV-ONLY DEFAULTS ─────────────────────────────────────────────────────

POSTGRES_USER=vg_user
POSTGRES_PASSWORD=vg_pass
POSTGRES_DB=vg_hub
ENVIRONMENT=development

# ─── SEEDING ───────────────────────────────────────────────────────────────
# Default deploy ships with NO data — the first visitor at /signup creates
# the bootstrap vg_admin (count > 0 guard then closes /register until an
# admin re-opens it via Settings → Public Signup). Flip the flags below
# only if you want the local demo dataset back.

# seed_demo.py: SanMar + VG-OPS suppliers, demo customers + products,
# master options. Set to 1 ONLY in local dev.
AUTO_SEED=0

# lifespan: ensure_default_admin (admin@example.com / DEMO_ADMIN_PASSWORD
# in dev, or random + log in prod). Leave 0 to use the signup flow.
SEED_ADMIN=0

# lifespan: ensure_vg_ops_supplier — single dev supplier row. Dev-only.
SEED_DEMO_SUPPLIER=0

# Only honored when SEED_ADMIN=1.
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=demo1234

# Separate test database used by pytest (avoids polluting the dev DB).
# Create with: docker exec api-hub-postgres-1 psql -U vg_user -d vg_hub \
#   -c "CREATE DATABASE vg_hub_test OWNER vg_user;"
TEST_DATABASE_URL=postgresql+asyncpg://vg_user:vg_pass@localhost:5432/vg_hub_test

# ─── BACKGROUND JOBS ───────────────────────────────────────────────────────

# Disable the 24h supplier import scheduler started by main.lifespan.
# Set true on any environment that does not need automatic delta syncs.
DISABLE_SCHEDULER=true

# ─── SUPPLIER PROTOCOLS ────────────────────────────────────────────────────

# SanMar SFTP (optional — only set if you need SanMar imports locally)
SANMAR_SFTP_HOST=ftp.sanmar.com
SANMAR_SFTP_PORT=2200
SANMAR_SFTP_USER=
SANMAR_SFTP_PASS=

# PromoStandards directory (read-only)
PS_DIRECTORY_URL=https://services.promostandards.org/WebServiceRepository/WebServiceRepository.svc/json

# ─── INTER-SERVICE URLS ────────────────────────────────────────────────────
# FastAPI owns OPS push (M1). The frontend's Next.js API routes call the
# backend via API_BASE_URL when they need to bridge browser → backend
# inside the Docker network.

API_BASE_URL=http://api:8000
