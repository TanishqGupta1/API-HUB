NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_N8N_URL=http://localhost:5678
NEXT_PUBLIC_PUSH_WORKFLOW_ID=vg-ops-push-001

# Phase 8 — live-mode toggle.
# Default (commented out) = mock mode, fixtures only, demos work without backend.
# Set to "true" + run M0 migration + create an integration key to hit real endpoints.
# NEXT_PUBLIC_PHASE8_LIVE=true

# Phase 8 — admin proxy toggle.
# When PHASE8_LIVE=true AND this is also "true", frontend hits the JWT-protected
# admin-push proxy (no orchestrator key needed). Useful for in-app demos without
# the operator copy-pasting an integration key.
# NEXT_PUBLIC_PHASE8_ADMIN_PROXY=true
